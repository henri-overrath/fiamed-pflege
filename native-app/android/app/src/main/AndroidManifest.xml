<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- android:allowBackup unten ist bewusst false, nicht nur Voreinstellung: Der
         Wundfoto-Speicher (IndexedDB, siehe lock.js) und der übrige App-Zustand liegen
         ausschließlich lokal verschlüsselt auf dem Gerät (CLAUDE.md Regel 2).
         allowBackup="false" schließt sowohl das klassische Google-Cloud-Backup als auch
         die Geräte-zu-Geräte-Migration beim Einrichten eines neuen Telefons aus - ohne
         das würden Gesundheitsdaten unbemerkt auf Google-Server bzw. ein anderes Gerät
         wandern, was der ganzen "kein Server"-Architektur widerspricht (siehe MARKT.md).
         Bitte nicht auf true ändern, auch nicht für Debug-Zwecke. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gerätesperre (Fingerabdruck/Gesicht/Geräte-Code) für lock.js -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
